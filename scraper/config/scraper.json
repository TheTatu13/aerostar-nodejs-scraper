{
  "userAgent": "job_seeker_ro_spider",
  "requestTimeoutMs": 10000,
  "pageDelayMs": 1000,
  "staleJobDeletion": false,
  "manageCompany": true,
  "defaultLocation": ["Bacau"],
  "defaultWorkmode": "on-site",
  "ownJobUrlPrefix": "https://cariere.aerostar.ro/jobs/",
  "sources": {
    "sitemap": "",
